# Keep source and reports in Git. Raw experiment archives stay in the research workspace.
*
!*/
!.gitignore
!*.py
!*.sh
!*.md
!requirements*.txt
!*.sha256
!frozen_utc.txt
!tangent_transfer_v40/*_utc.txt
!tangent_transfer_v40/v40.png
!tangent_transfer_v40/*.json
!tangent_transfer_v40/results/run.json
!tangent_transfer_v40/results/completion.json
!tangent_transfer_v40/monitor/results/worker_exit.json
!probe_value_v38/results/run.json
!probe_transfer_v39/results/completion.json
!bidirectional_probe_v34/diag_models.json
!bidirectional_probe_v34/anchored34.json
!bidirectional_probe_v34/policy_design34.json
!frozen_direction_v35/design35.json
!query_matched_probe_v36/design36.json
!query_matched_probe_v36/gate36_frozen.npz
!probe_speed_v37/design37.json
!probe_speed_v37/gate37_frozen.npz
.venv/
.venv-*/
__pycache__/
vendor/
